# Streamlit secrets template (valid TOML).
#
# For deployment: Streamlit Cloud -> Manage app -> Secrets, paste these lines.
# For local use: copy this file to .streamlit/secrets.toml (which is gitignored).
# Do NOT commit the real secrets.toml.

OPENROUTER_API_KEY = "your_openrouter_key_here"
OPENROUTER_MODEL = "openai/gpt-4o-mini"
